# Application Configuration
APP_NAME="Explainable Indian Constitutional Rights & Legal Assistant"
APP_ENV="development"
DEBUG=True
API_V1_STR="/api/v1"

# Security & JWT
SECRET_KEY="replace_with_a_secure_secret_key_in_production_run_openssl_rand_hex_32"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL + pgvector)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="legal_user"
POSTGRES_PASSWORD="legal_password"
POSTGRES_DB="legal_assistant_db"
DATABASE_URL="postgresql+asyncpg://legal_user:legal_password@localhost:5432/legal_assistant_db"

# LLM & Embedding Settings (configured in later stages)
LLM_PROVIDER="gemini"
LLM_API_KEY=""
EMBEDDING_MODEL="models/embedding-001"
LLM_MODEL="gemini-1.5-pro"
